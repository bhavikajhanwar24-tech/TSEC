# ============================================================
# RepoGuardian — single source of credentials for the backend
# and ALL agents (they load this file automatically).
# Copy this file to .env and fill in real values.
# ============================================================

# --- Backend server ---
PORT=3000
SESSION_SECRET=change_this_to_a_long_random_string
FRONTEND_URL=http://localhost:5173
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_APP_SLUG=your-github-app-slug
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# --- NVIDIA (shared by all agents) ---
NVIDIA_API_KEY=your_nvidia_api_key_here

# --- GitHub platform token (used by agents when no user session is available) ---
GITHUB_TOKEN=your_github_pat_here
GITHUB_OWNER=your_org_or_user
GITHUB_REPO=your_repo

# --- Optional NVIDIA model overrides (agents use their code defaults otherwise) ---
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5