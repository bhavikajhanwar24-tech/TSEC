# ============================================================
# RepoGuardian — single source of credentials for the backend
# and ALL agents (they load this file automatically).
# Copy this file to .env and fill in real values.
# ============================================================

# --- Backend server ---
PORT=3000
SESSION_SECRET=change_this_to_a_long_random_string
FRONTEND_URL=http://localhost:5173
GITHUB_CLIENT_ID=your_github_oauth_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret
GITHUB_APP_SLUG=your-github-app-slug
# Optional: use the exact GitHub App installation URL instead of the slug.
# GITHUB_APP_INSTALL_URL=https://github.com/apps/repogaurdian/installations/new
SESSION_SECRET=change_this_to_a_long_random_string
FRONTEND_URL=http://localhost:5173
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
# Alternative name accepted for GitHub App webhooks.
# GITHUB_APP_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_TOKEN=github_token_for_automatic_agents

# --- NVIDIA (shared by all agents) ---
NVIDIA_API_KEY=your_nvidia_api_key_here
# Optional faster model used only by the repository chatbot.
# NVIDIA_CHAT_MODEL=your_fast_nvidia_chat_model
# --- Optional NVIDIA model overrides (agents use their code defaults otherwise) ---
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# --- Database ---
DATABASE_URL=your_postgres_database_url_here
